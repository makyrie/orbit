{
	"name": "orbit/orbit",
	"description": "Orbit — person-centric social activity tool for WordPress",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0",
		"woocommerce/action-scheduler": "^3.9"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-phpunit/wp-phpunit": "^6.0"
	},
	"autoload": {
		"classmap": [
			"includes/",
			"cli/"
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"scripts": {
		"policy-diff": "php bin/check-policy-sync.php"
	}
}
